[Unit]
Description=Zen Shell — Hyprland monitor auto-enable watcher
Documentation=https://github.com/Gekinzen/zen_barebone_alpha_development
PartOf=graphical-session.target
After=graphical-session.target
# Only relevant when Hyprland is up — graphical-session.target gates this
ConditionEnvironment=HYPRLAND_INSTANCE_SIGNATURE

[Service]
Type=simple
ExecStart=%h/.local/bin/zen-monitor-watcher.sh
Restart=on-failure
RestartSec=3
# Keep the log fresh on every restart by truncating; the script itself
# does `: > "$LOG"` at start so this is belt-and-suspenders.

[Install]
WantedBy=graphical-session.target
