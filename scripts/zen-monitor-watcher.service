[Unit]
Description=Zen Shell — Hyprland monitor auto-enable watcher
Documentation=https://github.com/Gekinzen/zen_barebone_alpha_development
PartOf=graphical-session.target
After=graphical-session.target
# Only relevant when Hyprland is up — without this var, the watcher exits cleanly
ConditionEnvironment=HYPRLAND_INSTANCE_SIGNATURE

[Service]
Type=simple
ExecStart=%h/.local/bin/zen-monitor-watcher.sh
Restart=on-failure
RestartSec=3
# Make sure the watcher inherits the Hyprland session env (HYPRLAND_INSTANCE_SIGNATURE)
PassEnvironment=HYPRLAND_INSTANCE_SIGNATURE XDG_RUNTIME_DIR

[Install]
WantedBy=graphical-session.target
