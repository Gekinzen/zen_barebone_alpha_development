#!/usr/bin/env bash
# ════════════════════════════════════════════════════════════════
# prime-run v6.16.1 — one-shot dedicated-GPU launcher
# ────────────────────────────────────────────────────────────────
# Runs a command with dGPU env vars set (Mesa PRIME + NVIDIA Optimus
# render offload). Useful for one-off "run this on dGPU" without
# changing the system-wide GPU mode in GPUSwitcherService.
#
# Usage:
#   prime-run firefox
#   prime-run steam
#   prime-run glxgears     # test: should show dGPU vendor
#
# Auto-detects available GPU vendors and sets only the env vars
# that make sense for the detected hardware.
# ════════════════════════════════════════════════════════════════

if [ $# -eq 0 ]; then
    echo "Usage: prime-run <command> [args...]" >&2
    echo "       Runs <command> on the dedicated GPU." >&2
    exit 1
fi

# Mesa PRIME offload (works for AMD-on-AMD, Intel-on-AMD, etc.)
export DRI_PRIME=1

# NVIDIA Optimus — only set if NVIDIA GPU is present
if lspci -nn 2>/dev/null | grep -qi 'nvidia'; then
    export __NV_PRIME_RENDER_OFFLOAD=1
    export __GLX_VENDOR_LIBRARY_NAME=nvidia
    export __VK_LAYER_NV_optimus=NVIDIA_only
fi

exec "$@"
