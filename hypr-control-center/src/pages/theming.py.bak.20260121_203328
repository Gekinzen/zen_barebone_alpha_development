def generate_control_center_css(colors: dict) -> str:
    """
    Generate COMPLETE CSS for Control Center based on theme colors.
    This replaces GTK theming - all colors come from the theme.
    Handles both light and dark themes with proper contrast.
    """
    light = is_light_theme(colors)
    
    # For light themes: selected items need dark text
    # For dark themes: selected items can have white text
    selected_text = "#000000" if light else "#ffffff"
    sidebar_icon_color = colors['fg'] if light else "#ffffff"
    sidebar_selected_icon = "#000000"  # Always dark on selected (blue bg)
    
    # Hover states - lighter for dark themes, darker for light themes
    hover_bg = colors['bg2'] if not light else colors['bg2']
    
    return f'''/* ═══════════════════════════════════════════════════════════════ */
