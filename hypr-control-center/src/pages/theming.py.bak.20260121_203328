def is_light_theme(colors: dict) -> bool:
    """
    Determine if theme is light or dark based on background luminance.
    Returns True if light theme (bright background), False if dark.
    """
    bg = colors.get("bg0", "#282c34")
    try:
        hex_color = bg.lstrip('#')
        r, g, b = tuple(int(hex_color[i:i+2], 16) for i in (0, 2, 4))
        # Calculate relative luminance
        luminance = (0.299 * r + 0.587 * g + 0.114 * b) / 255
        return luminance > 0.5
    except:
        return False


def get_text_color_for_bg(colors: dict, bg_key: str = "bg0") -> str:
    """Get appropriate text color for a background - ensures readability"""
    bg = colors.get(bg_key, "#282c34")
    try:
        hex_color = bg.lstrip('#')
        r, g, b = tuple(int(hex_color[i:i+2], 16) for i in (0, 2, 4))
        luminance = (0.299 * r + 0.587 * g + 0.114 * b) / 255
        return colors.get("fg") if luminance < 0.5 else "#000000"
    except:
        return colors.get("fg", "#ffffff")


def get_current_theme_colors() -> dict:
    """Get colors from saved theme, checking preferences first"""
    for theme_file in [PREFERENCES_THEME_FILE, CURRENT_THEME_FILE]:
        try:
            if theme_file.exists():
                with open(theme_file, 'r') as f:
                    return json.load(f).get('colors', {})
        except: 
            continue
    return BUILTIN_THEMES["one-dark"]["colors"]


def get_current_theme_data() -> dict:
    """Get full theme data from saved theme"""
    for theme_file in [PREFERENCES_THEME_FILE, CURRENT_THEME_FILE]:
        try:
            if theme_file.exists():
                with open(theme_file, 'r') as f:
                    return json.load(f)
        except: 
            continue
    return {"id": "one-dark", "name": "One Dark", "colors": BUILTIN_THEMES["one-dark"]["colors"], "is_builtin": True}


