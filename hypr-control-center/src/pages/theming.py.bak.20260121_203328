def _build_waybar_section(window, colors, waybar_cfg):
    content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
    content.set_margin_start(16); content.set_margin_end(16); content.set_margin_top(8); content.set_margin_bottom(16)
    
    if not hasattr(window, 'theming_widgets'): window.theming_widgets = {}
    
    # Preview
    preview = WaybarPreviewWidget(colors, waybar_cfg); window.waybar_preview = preview
    frame = Gtk.Frame(); frame.set_child(preview); content.append(frame)
    hint = Gtk.Label(label="Hover workspaces to see hover state")
    hint.add_css_class("dim-label"); hint.add_css_class("caption"); hint.set_margin_top(4); hint.set_margin_bottom(8)
    content.append(hint)
    
    # PANEL BEHAVIOR
    content.append(_create_section_header("PANEL BEHAVIOR"))
    
    # Position
    pos_row = _create_setting_row("Position on Screen", "Where the panel appears on screen")
    pos_dd = Gtk.DropDown(); pos_dd.set_model(Gtk.StringList.new(["top", "bottom"]))
    pos_dd.set_selected(0 if get_current_waybar_position() == "top" else 1); pos_dd.set_valign(Gtk.Align.CENTER)
    pos_dd.connect('notify::selected', lambda d, _: _on_position_change("top" if d.get_selected() == 0 else "bottom", window))
    pos_row.append(pos_dd); content.append(pos_row)
    
    # Show on Display
    disp_row = _create_setting_row("Show on Display", "Which monitor to show the panel on")
    monitors = get_monitor_list()
    disp_dd = Gtk.DropDown(); disp_dd.set_model(Gtk.StringList.new(monitors))
    cur_out = get_current_waybar_output()
    sel_idx = next((i for i, m in enumerate(monitors) if m == cur_out), 0)
    disp_dd.set_selected(sel_idx); disp_dd.set_valign(Gtk.Align.CENTER)
    disp_dd.connect('notify::selected', lambda d, _: _on_output_change(monitors[d.get_selected()] if d.get_selected() < len(monitors) else "All Monitors", window))
    disp_row.append(disp_dd); content.append(disp_row)
    
    # PANEL APPEARANCE
    content.append(_create_section_header("PANEL APPEARANCE"))
    
    # Init style manager
    try:
        from ..waybar_style_manager import WaybarStyleManager
        if not hasattr(window, 'waybar_style_manager'):
            window.waybar_style_manager = WaybarStyleManager(WAYBAR_DIR); window.waybar_style_manager.load_style()
    except: window.waybar_style_manager = None
    
    # Style
    style_row = _create_setting_row("Panel Style")
    style_dd = Gtk.DropDown(); style_dd.set_model(Gtk.StringList.new(["Minimal", "Modern"]))
    cur_mode = window.waybar_style_manager.get_current_style_mode() if window.waybar_style_manager else 'minimal'
    style_dd.set_selected(0 if cur_mode == 'minimal' else 1); style_dd.set_valign(Gtk.Align.CENTER)
    style_dd.connect('notify::selected', lambda d, _: _on_style_mode_change(d, window))
    style_row.append(style_dd); content.append(style_row)
    
    # Font Size
    font_row = _create_setting_row("Panel Font Size")
    cur_font = window.waybar_style_manager.get_current_font_size() if window.waybar_style_manager else 16
    font_btns = _create_size_buttons([('Small', 10), ('Medium', 16), ('Large', 20), ('X-Large', 26)], cur_font or 16, _on_font_size_change, window)
    font_row.append(font_btns); content.append(font_row)
    
    # Height
    height_row = _create_setting_row("Panel Height")
    height_btns = _create_size_buttons([('Small', 10), ('Medium', 20), ('Large', 30), ('X-Large', 40)], 20, _on_height_change, window)
    height_row.append(height_btns); content.append(height_row)
    
    # Transparent
    trans_row = _create_setting_row("Transparent Background", "Use fully transparent background")
    is_trans = window.waybar_style_manager.is_transparent() if window.waybar_style_manager else False
    trans_sw = Gtk.Switch(); trans_sw.set_active(is_trans); trans_sw.set_valign(Gtk.Align.CENTER)
    trans_sw.connect('notify::active', lambda s, _: _on_transparent_toggle(s.get_active(), window))
    trans_row.append(trans_sw); content.append(trans_row)
    
    # Opacity
    opacity_row = _create_setting_row("Background Opacity", "Panel background transparency (0=clear, 1=opaque)")
    cur_opacity = window.waybar_style_manager.get_current_opacity() if window.waybar_style_manager else 0.6
    opacity_lbl = Gtk.Label(label=f"{cur_opacity or 0.6:.2f}"); opacity_lbl.set_width_chars(5)
    window.theming_widgets['opacity_label'] = opacity_lbl; opacity_row.append(opacity_lbl)
    opacity_sl = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0.0, 1.0, 0.01)
    opacity_sl.set_value(cur_opacity or 0.6); opacity_sl.set_size_request(150, -1); opacity_sl.set_draw_value(False)
    opacity_sl.set_sensitive(not is_trans)
    opacity_sl.connect('value-changed', lambda s: _on_opacity_change(s.get_value(), window))
    window.theming_widgets['opacity_slider'] = opacity_sl; opacity_row.append(opacity_sl); content.append(opacity_row)
    
    # Radius
    radius_row = _create_setting_row("Border Radius", "Corner roundness in pixels")
    cur_radius = window.waybar_style_manager.get_border_radius() if window.waybar_style_manager else 46
    radius_spin = Gtk.SpinButton.new_with_range(0, 50, 1); radius_spin.set_value(cur_radius or 46); radius_spin.set_valign(Gtk.Align.CENTER)
    radius_spin.connect('value-changed', lambda s: _on_radius_change(int(s.get_value()), window))
    radius_row.append(radius_spin); content.append(radius_row)
    
    # MARGINS
    content.append(_create_section_header("MARGINS"))
    
    # Get current margin values from waybar config
    current_margins = get_current_waybar_margins()
    
    for side in ['top', 'bottom', 'left', 'right']:
        margin_row = _create_setting_row(f"Margin {side.title()}", f"Space from screen {side}")
        margin_spin = Gtk.SpinButton.new_with_range(0, 100, 1)
        margin_spin.set_value(current_margins.get(side, 0))  # Use current value!
        margin_spin.set_valign(Gtk.Align.CENTER)
        margin_spin.connect('value-changed', lambda s, sd=side: _on_margin_change(sd, int(s.get_value()), window))
        margin_row.append(margin_spin)
        content.append(margin_row)
    
    # WORKSPACE COLORS
    content.append(_create_section_header("WORKSPACE COLORS"))
    
    ws_cfg = waybar_cfg.get("workspaces", {})
    def on_ws(key, val):
        if "workspaces" not in window.current_waybar_config: window.current_waybar_config["workspaces"] = {}
        window.current_waybar_config["workspaces"]["button_" + key] = val
        window.waybar_preview.update_waybar_config(window.current_waybar_config)
    
    for lbl, cur in [("Hover Background", ws_cfg.get("button_hover_bg", "purple")),
                     ("Active Background", ws_cfg.get("button_active_bg", "blue")),
                     ("Urgent Background", ws_cfg.get("button_urgent_bg", "red"))]:
        content.append(ColorVariableDropdown(lbl, cur, colors, on_ws))
    
    # MODULE COLORS
    content.append(_create_section_header("MODULE COLORS"))
    
    mods_cfg = waybar_cfg.get("modules", {})
    def on_mod(key, val):
        if "modules" not in window.current_waybar_config: window.current_waybar_config["modules"] = {}
        mod = key.split("_")[0]
        if mod not in window.current_waybar_config["modules"]: window.current_waybar_config["modules"][mod] = {}
        window.current_waybar_config["modules"][mod]["color"] = val
        window.waybar_preview.update_waybar_config(window.current_waybar_config)
    
    for lbl, cur in [("CPU Color", mods_cfg.get("cpu", {}).get("color", "blue")),
                     ("Memory Color", mods_cfg.get("memory", {}).get("color", "green")),
                     ("Clock Color", mods_cfg.get("clock", {}).get("color", "blue")),
                     ("Network Color", mods_cfg.get("network", {}).get("wifi", "purple"))]:
        content.append(ColorVariableDropdown(lbl, cur, colors, on_mod))
    
    return content


