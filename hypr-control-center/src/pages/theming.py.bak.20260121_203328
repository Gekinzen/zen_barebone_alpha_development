def _create_swatch(key, label, hex_color):
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4); box.set_halign(Gtk.Align.CENTER)
    swatch = Gtk.DrawingArea(); swatch.set_content_width(40); swatch.set_content_height(40)
    swatch.hex_color = hex_color
    def draw(a, cr, w, h): cr.set_source_rgba(*_hex_to_rgba(a.hex_color)); _draw_rounded_rect(cr, 0, 0, w, h, 6); cr.fill()
    swatch.set_draw_func(draw); box.append(swatch)
    lbl = Gtk.Label(label=label); lbl.add_css_class("caption"); lbl.add_css_class("dim-label"); box.append(lbl)
    box.swatch = swatch
    return box

def _create_size_buttons(sizes, current, on_change, window):
    box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0); box.add_css_class('linked')
    buttons = []
    for name, val in sizes:
        btn = Gtk.ToggleButton(label=name)
        if val == current: btn.set_active(True)
        buttons.append(btn); box.append(btn)
    for i, btn in enumerate(buttons):
        btn.connect('toggled', lambda b, v=sizes[i][1], grp=buttons: _on_size_toggled(b, v, grp, on_change, window))
    return box

def _on_size_toggled(btn, val, grp, on_change, window):
    if btn.get_active():
        for b in grp:
            if b != btn and b.get_active(): b.set_active(False)
        on_change(val, window)


