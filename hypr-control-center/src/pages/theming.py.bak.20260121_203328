            if tid: pm.set_active_theme(tid, False); _refresh_dropdown(window, pm); _refresh_ui(window, pm)
        d.destroy()
    dialog.connect("response", on_resp); dialog.present()

def _show_delete_dialog(window, pm):
    theme = pm.get_active_theme()
    if theme.get("is_builtin", True): return
    dialog = Adw.MessageDialog(transient_for=window, heading="Delete Profile?", body=f"Delete '{theme.get('name')}'?")
    dialog.add_response("cancel", "Cancel"); dialog.add_response("delete", "Delete")
    dialog.set_response_appearance("delete", Adw.ResponseAppearance.DESTRUCTIVE)
    def on_resp(d, r):
        if r == "delete": pm.delete_custom_theme(theme.get("id")); _refresh_dropdown(window, pm); _refresh_ui(window, pm)
        d.destroy()
    dialog.connect("response", on_resp); dialog.present()


