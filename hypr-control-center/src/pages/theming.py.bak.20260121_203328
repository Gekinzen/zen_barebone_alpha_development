# HYPRLAND INTEGRATION - Update window rounding
# ═══════════════════════════════════════════════════════════════════════════════

def apply_hyprland_rounding(radius: int = 12):
    """
    Update Hyprland window rounding decoration.
    Modifies decoration:rounding in hyprland.conf
    """
    try:
        if not HYPRLAND_CONF.exists():
            print(f"[Theming] Hyprland config not found: {HYPRLAND_CONF}")
            return False
        
        content = HYPRLAND_CONF.read_text()
        
        # Pattern to find rounding value in decoration block
        # Handles both "rounding = X" and "rounding=X"
        pattern = r'(decoration\s*\{[^}]*rounding\s*=\s*)(\d+)'
        
        if re.search(pattern, content, re.DOTALL):
            content = re.sub(pattern, rf'\g<1>{radius}', content, flags=re.DOTALL)
            HYPRLAND_CONF.write_text(content)
            
            # Reload Hyprland config
            subprocess.run(['hyprctl', 'reload'], capture_output=True)
            print(f"[Theming] Applied Hyprland rounding: {radius}px")
            return True
        else:
            print("[Theming] Could not find decoration:rounding in hyprland.conf")
            return False
    except Exception as e:
        print(f"[Theming] Hyprland rounding error: {e}")
        return False


