class ThemeApplier:
    @staticmethod
    def apply_waybar_colorscheme(theme_data):
        colors = theme_data.get("colors", {})
        tid = theme_data.get("id", "custom")
        css = f"/* {theme_data.get('name', 'Custom')} */\n"
        for k, v in colors.items(): css += f"@define-color {k} {v};\n"
        WAYBAR_COLORSCHEME_DIR.mkdir(parents=True, exist_ok=True)
        with open(WAYBAR_COLORSCHEME_DIR / f"{tid}.css", 'w') as f: f.write(css)
        
        style_file = WAYBAR_DIR / "style.css"
        if style_file.exists():
            content = style_file.read_text()
            if "@import" in content:
                lines = content.split('\n')
                for i, line in enumerate(lines):
                    if "@import" in line and "colorscheme" in line:
                        lines[i] = f"@import '../hypr/colorscheme/{tid}.css';"; break
                style_file.write_text('\n'.join(lines))
        return True
    
    @staticmethod
    def apply_rofi_colors(theme_data):
        rofi = theme_data.get("rofi", {})
        colors = theme_data.get("colors", {})
        def gc(c): return f"#{c.lstrip('#').upper()}FF" if len(c.lstrip('#')) == 6 else f"#{c.lstrip('#').upper()}"
        ROFI_SHARED_DIR.mkdir(parents=True, exist_ok=True)
        content = f'''* {{
    background:     {gc(rofi.get("background", colors.get("bg0", "#282c34")))};
    background-alt: {gc(rofi.get("background-alt", colors.get("bg1", "#21252b")))};
    foreground:     {gc(rofi.get("foreground", colors.get("fg", "#abb2bf")))};
    selected:       {gc(rofi.get("selected", colors.get("blue", "#61afef")))};
    active:         {gc(rofi.get("active", colors.get("green", "#98c379")))};
    urgent:         {gc(rofi.get("urgent", colors.get("red", "#e06c75")))};
}}'''
        try: ROFI_COLORS_RASI.write_text(content); return True
        except: return False
    
    @staticmethod
    def apply_kitty_colors(theme_data):
        kitty = theme_data.get("kitty", {})
        colors = theme_data.get("colors", {})
        if not KITTY_CONF.exists(): return False
        try:
            content = KITTY_CONF.read_text()
            for k in ["background", "foreground", "cursor"]:
                v = kitty.get(k, colors.get("bg0" if k == "background" else "fg" if k == "foreground" else "blue", "#abb2bf"))
                if re.search(rf'^{k}\s+', content, re.MULTILINE):
                    content = re.sub(rf'^({k}\s+)#?[a-fA-F0-9]+.*$', rf'\g<1>{v}', content, flags=re.MULTILINE)
            KITTY_CONF.write_text(content); return True
        except: return False
    
    @staticmethod
    def apply_control_center_theme(theme_data, window=None):
        """Apply theme with FULL CSS generation and persistence"""
        colors = theme_data.get("colors", {})
        ASSETS_DIR.mkdir(parents=True, exist_ok=True)
        PREFERENCES_DIR.mkdir(parents=True, exist_ok=True)
        THEMES_DIR.mkdir(parents=True, exist_ok=True)
        
        # Generate complete CSS files
        cc_css = generate_control_center_css(colors)
        CONTROL_CENTER_CSS.write_text(cc_css)
        print(f"[Theme] ✅ Generated Control Center CSS")
        
        sm_css = generate_start_menu_css(colors)
        START_MENU_CSS.write_text(sm_css)
        print(f"[Theme] ✅ Generated Start Menu CSS")
        
        # Generate Panel Widget CSS
        pw_css = generate_panel_widget_css(colors)
        PANEL_WIDGET_CSS.write_text(pw_css)
        print(f"[Theme] ✅ Generated Panel Widget CSS")
        
        # Prepare save data with persistence info
        save_data = {
            "id": theme_data.get("id"),
            "name": theme_data.get("name"),
            "colors": colors,
            "is_builtin": theme_data.get("is_builtin", True),
            "active_profile": theme_data.get("id"),
            "active_profile_type": "builtin" if theme_data.get("is_builtin", True) else "custom"
        }
        
        # Save to BOTH locations for persistence
        for path in [CURRENT_THEME_FILE, PREFERENCES_THEME_FILE]:
            try:
                with open(path, 'w') as f:
                    json.dump(save_data, f, indent=2)
                print(f"[Theme] ✅ Saved to: {path.name}")
            except Exception as e:
                print(f"[Theme] Save error {path}: {e}")
        
        # IMPORTANT: Sync profiles.json for persistence on restart
        try:
            profiles = {}
            if PROFILES_FILE.exists():
                with open(PROFILES_FILE, 'r') as f:
                    profiles = json.load(f)
            profiles["active_profile"] = theme_data.get("id", "one-dark")
            profiles["active_profile_type"] = "builtin" if theme_data.get("is_builtin", True) else "custom"
            with open(PROFILES_FILE, 'w') as f:
                json.dump(profiles, f, indent=2)
            print(f"[Theme] ✅ Synced profiles.json: {profiles['active_profile']}")
        except Exception as e:
            print(f"[Theme] ⚠️ Profile sync error: {e}")
        
        print(f"[Theme] 🎨 Applied: {theme_data.get('name')} ({theme_data.get('id')})")
        
        if window: ThemeApplier._reload_css(window)
        return True
    
    @staticmethod
    def _reload_css(window):
        global _CONTROL_CENTER_CSS_PROVIDER
        display = Gdk.Display.get_default()
        if not display: return
        if _CONTROL_CENTER_CSS_PROVIDER:
            try: Gtk.StyleContext.remove_provider_for_display(display, _CONTROL_CENTER_CSS_PROVIDER)
            except: pass
        _CONTROL_CENTER_CSS_PROVIDER = Gtk.CssProvider()
        if CONTROL_CENTER_CSS.exists():
            try: _CONTROL_CENTER_CSS_PROVIDER.load_from_path(str(CONTROL_CENTER_CSS))
            except: return
        try: Gtk.StyleContext.add_provider_for_display(display, _CONTROL_CENTER_CSS_PROVIDER, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 100)
        except: pass
        if window: window.queue_resize()
    
    @staticmethod
    def reload_waybar():
        try: subprocess.run(["pkill", "-SIGUSR2", "waybar"], check=False)
        except: pass
    
    @staticmethod
    def reload_kitty():
        try: subprocess.run(["pkill", "-USR1", "kitty"], check=False)
        except: pass
    
    @staticmethod
    def notify(title, message):
        try: subprocess.run(["notify-send", "-a", "Hyprland Control Center", title, message], check=False)
        except: pass


