def get_saved_theme_data() -> dict:
    """
    Get the currently saved theme data WITHOUT modifying any files.
    This is a read-only function for checking what theme is saved.
    
    Returns:
        dict: The saved theme data or None if no theme is saved
    """
    # Priority 1: preferences/theme.json (user's explicit choice)
    if PREFERENCES_THEME_FILE.exists():
        try:
            with open(PREFERENCES_THEME_FILE, 'r') as f:
                data = json.load(f)
                if data.get('colors'):
                    print(f"[Theme] 📖 Read saved theme: {data.get('name')} from preferences/theme.json")
                    return data
        except Exception as e:
            print(f"[Theme] ⚠️ Error reading preferences/theme.json: {e}")
    
    # Priority 2: current-theme.json
    if CURRENT_THEME_FILE.exists():
        try:
            with open(CURRENT_THEME_FILE, 'r') as f:
                data = json.load(f)
                if data.get('colors'):
                    print(f"[Theme] 📖 Read saved theme: {data.get('name')} from current-theme.json")
                    return data
        except Exception as e:
            print(f"[Theme] ⚠️ Error reading current-theme.json: {e}")
    
    # Priority 3: profiles.json active_profile
    if PROFILES_FILE.exists():
        try:
            with open(PROFILES_FILE, 'r') as f:
                profiles = json.load(f)
                theme_id = profiles.get("active_profile")
                if theme_id and theme_id in BUILTIN_THEMES:
                    print(f"[Theme] 📖 Using profile active_profile: {theme_id}")
                    return {
                        "id": theme_id,
                        "name": BUILTIN_THEMES[theme_id]["name"],
                        "colors": BUILTIN_THEMES[theme_id]["colors"],
                        "is_builtin": True
                    }
        except Exception as e:
            print(f"[Theme] ⚠️ Error reading profiles.json: {e}")
    
    return None


def initialize_saved_theme(window=None) -> dict:
    """
    Initialize theme on application startup.
    Loads saved theme from preferences and applies FULL CSS.
    
    CRITICAL: This function reads the SAVED theme and applies it.
    It does NOT create a new default theme if one already exists.
    
    IMPORTANT: Call this in main window's __init__ or do_activate().
    
    Args:
        window: Optional GTK window for CSS reload
    
    Returns:
        dict: The loaded theme data
    """
    global _CONTROL_CENTER_CSS_PROVIDER
    
    print("[Theme] ════════════════════════════════════════════════════")
    print("[Theme] 🚀 INITIALIZING SAVED THEME ON STARTUP")
    print("[Theme] ════════════════════════════════════════════════════")
    
    # Step 1: Read saved theme (without modifying files)
    theme_data = get_saved_theme_data()
    
    # Step 2: Only fall back to One Dark if NO theme is saved at all
    if not theme_data:
        print("[Theme] ⚠️ No saved theme found - this is a fresh install")
        print("[Theme] 📝 Creating default One Dark theme")
        theme_data = {
            "id": "one-dark",
            "name": "One Dark",
            "colors": BUILTIN_THEMES["one-dark"]["colors"],
            "is_builtin": True
        }
        
        # Save default theme for fresh install
        PREFERENCES_DIR.mkdir(parents=True, exist_ok=True)
        try:
            with open(PREFERENCES_THEME_FILE, 'w') as f:
                json.dump(theme_data, f, indent=2)
            print(f"[Theme] 💾 Saved default theme to preferences/theme.json")
        except Exception as e:
            print(f"[Theme] ⚠️ Could not save default theme: {e}")
    else:
        print(f"[Theme] ✅ Found saved theme: {theme_data.get('name')} (id={theme_data.get('id')})")
    
    colors = theme_data.get('colors', BUILTIN_THEMES["one-dark"]["colors"])
    
    # Step 3: Generate CSS files from the loaded theme
    ASSETS_DIR.mkdir(parents=True, exist_ok=True)
    
    # Generate Control Center CSS
    cc_css = generate_control_center_css(colors)
    CONTROL_CENTER_CSS.write_text(cc_css)
    print(f"[Theme] ✅ Generated Control Center CSS: {theme_data.get('name')}")
    
    # Generate Start Menu CSS
    sm_css = generate_start_menu_css(colors)
    START_MENU_CSS.write_text(sm_css)
    print(f"[Theme] ✅ Generated Start Menu CSS")
    
    # Generate Panel Widget CSS
    pw_css = generate_panel_widget_css(colors)
    PANEL_WIDGET_CSS.write_text(pw_css)
    print(f"[Theme] ✅ Generated Panel Widget CSS")
    
    # Step 4: Ensure current-theme.json is in sync (for other apps to read)
    try:
        with open(CURRENT_THEME_FILE, 'w') as f:
            json.dump(theme_data, f, indent=2)
    except Exception as e:
        print(f"[Theme] ⚠️ Could not sync current-theme.json: {e}")
    
    # Step 5: Sync profiles.json
    try:
        THEMES_DIR.mkdir(parents=True, exist_ok=True)
        profiles = {}
        if PROFILES_FILE.exists():
            with open(PROFILES_FILE, 'r') as f:
                profiles = json.load(f)
        profiles["active_profile"] = theme_data.get("id", "one-dark")
        profiles["active_profile_type"] = "builtin" if theme_data.get("is_builtin", True) else "custom"
        with open(PROFILES_FILE, 'w') as f:
            json.dump(profiles, f, indent=2)
    except Exception as e:
        print(f"[Theme] ⚠️ Profile sync error: {e}")
    
    # Step 8: Apply CSS provider for Control Center
    display = Gdk.Display.get_default()
    if display:
        # Remove old provider if exists
        if _CONTROL_CENTER_CSS_PROVIDER:
            try:
                Gtk.StyleContext.remove_provider_for_display(display, _CONTROL_CENTER_CSS_PROVIDER)
            except:
                pass
        
        # Create and load new provider
        _CONTROL_CENTER_CSS_PROVIDER = Gtk.CssProvider()
        try:
            _CONTROL_CENTER_CSS_PROVIDER.load_from_path(str(CONTROL_CENTER_CSS))
            Gtk.StyleContext.add_provider_for_display(
                display, 
                _CONTROL_CENTER_CSS_PROVIDER,
                Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 100
            )
            print(f"[Theme] ✅ CSS provider loaded: {theme_data.get('name')}")
        except Exception as e:
            print(f"[Theme] CSS load error: {e}")
    
    # Trigger window redraw if provided
    if window:
        window.queue_resize()
    
    print(f"[Theme] 🎨 Initialized: {theme_data.get('name')} ({theme_data.get('id')})")
    print("[Theme] ════════════════════════════════════════════════════")
    return theme_data


def ensure_theme_initialized(window=None) -> dict:
    """
    Convenience function to ensure theme is initialized.
    Call this in your main.py or window.py __init__ method.
    
    Usage in main.py:
        from modules.theming import ensure_theme_initialized
        
        class MainWindow(Gtk.ApplicationWindow):
            def __init__(self, *args, **kwargs):
                super().__init__(*args, **kwargs)
                # Initialize theme FIRST before building UI
                ensure_theme_initialized(self)
                self._build_ui()
    
    Or in Application.do_activate():
        def do_activate(self):
            win = MainWindow(application=self)
            ensure_theme_initialized(win)
            win.present()
    """
    return initialize_saved_theme(window)


