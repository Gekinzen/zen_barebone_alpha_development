    --grey1: {colors.get('grey1', '#828997')};
    --grey2: {colors.get('grey2', '#abb2bf')};
    --red: {colors.get('red', '#e06c75')};
    --orange: {colors.get('orange', '#d19a66')};
    --yellow: {colors.get('yellow', '#e5c07b')};
    --green: {colors.get('green', '#98c379')};
