def get_monitor_list() -> List[str]:
    """Get list of available monitors using hyprctl"""
    monitors = ["All Monitors"]
    try:
        result = subprocess.run(["hyprctl", "monitors", "-j"], capture_output=True, text=True, timeout=5)
        if result.returncode == 0:
            for mon in json.loads(result.stdout):
                if mon.get("name"): monitors.append(mon["name"])
            return monitors
    except: pass
    return ["All Monitors", "DP-1", "DP-2", "HDMI-A-1", "eDP-1"]

def get_current_waybar_output() -> str:
    """Get current output setting from waybar config.jsonc"""
    try:
        if WAYBAR_CONFIG.exists():
            content = WAYBAR_CONFIG.read_text()
            content = re.sub(r'//.*$', '', content, flags=re.MULTILINE)
            content = re.sub(r'/\*.*?\*/', '', content, flags=re.DOTALL)
            return json.loads(content).get("output", "")
    except: pass
    return ""

def get_current_waybar_position() -> str:
    """Get current position from waybar config.jsonc"""
    try:
        if WAYBAR_CONFIG.exists():
            content = WAYBAR_CONFIG.read_text()
            content = re.sub(r'//.*$', '', content, flags=re.MULTILINE)
            content = re.sub(r'/\*.*?\*/', '', content, flags=re.DOTALL)
            return json.loads(content).get("position", "top")
    except: pass
    return "top"

def get_current_waybar_margins() -> dict:
    """Get current margin settings from waybar config.jsonc"""
    margins = {"top": 0, "bottom": 0, "left": 0, "right": 0}
    try:
        if WAYBAR_CONFIG.exists():
            content = WAYBAR_CONFIG.read_text()
            # Strip comments
            content = re.sub(r'//.*$', '', content, flags=re.MULTILINE)
            content = re.sub(r'/\*.*?\*/', '', content, flags=re.DOTALL)
            config = json.loads(content)
            
            for side in ["top", "bottom", "left", "right"]:
                key = f"margin-{side}"
                if key in config:
                    margins[side] = config[key]
    except Exception as e:
        print(f"[Theming] Error reading waybar margins: {e}")
    return margins

def update_waybar_config_field(field: str, value: Any):
    """Update a field in waybar config.jsonc"""
    try:
        if not WAYBAR_CONFIG.exists(): return False
        content = WAYBAR_CONFIG.read_text()
        
        if field == "output":
            if value == "" or value == "All Monitors":
                content = re.sub(r',?\s*"output"\s*:\s*"[^"]*"', '', content)
            elif re.search(r'"output"\s*:', content):
                content = re.sub(r'("output"\s*:\s*)"[^"]*"', f'\\1"{value}"', content)
            else:
                content = re.sub(r'(\s*)(}\s*)$', f',\n    "output": "{value}"\\1\\2', content)
        elif field == "position":
            if re.search(r'"position"\s*:', content):
                content = re.sub(r'("position"\s*:\s*)"[^"]*"', f'\\1"{value}"', content)
        elif field == "height":
            if re.search(r'"height"\s*:', content):
                content = re.sub(r'("height"\s*:\s*)\d+', f'\\g<1>{value}', content)
        elif field.startswith("margin-"):
            if re.search(rf'"{field}"\s*:', content):
                content = re.sub(rf'("{field}"\s*:\s*)\d+', f'\\g<1>{value}', content)
        
        WAYBAR_CONFIG.write_text(content)
        return True
    except: return False


