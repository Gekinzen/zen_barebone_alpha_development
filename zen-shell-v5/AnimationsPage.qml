import QtQuick
import QtQuick.Layouts
import QtQuick.Controls
import Quickshell
import Quickshell.Io

/*
 * AnimationsPage v6.16.3.4.3
 *
 * Changes vs v6.16.3.4.2:
 *   (1) Current-preset DETECTION — previously the page only read its own
 *       state JSON (animation-state.json), so on fresh installs or after
 *       manual edits the dropdown always showed "Default (Current)" even
 *       when Hyprland was running a different animation config.
 *
 *       Fix: also read ~/.config/hypr/modules/animations.conf and match
 *       its content against the known preset dictionary. Priority order:
 *         1. Parse "# Generated by Zen Settings — preset: <n>" header
 *            (fastest, set by our own writer)
 *         2. Normalized content match against preset dict
 *         3. If neither matches → synthesize "Custom (External Edit)"
 *            pseudo-preset showing current live config read-only.
 *       Additionally FileView watchChanges so external edits (or other
 *       tools that touch animations.conf) update the page in real time.
 *
 *   (2) Scroll-cutoff FIX — the ColumnLayout was positioned with
 *       `x: 24; y: 24` inside the ScrollView. ScrollView's auto-
 *       contentHeight didn't properly account for the 24px y-offset,
 *       and the trailing spacer was only 24px — so the last widget
 *       (PageFooter / Reset) was clipped at the bottom.
 *
 *       Fix: wrap the ColumnLayout in an Item that explicitly reports
 *       implicitHeight = contentCol.y + contentCol.implicitHeight + 48.
 *       Bottom spacer bumped to 48px for visual breathing room.
 *
 * Wala tayong babawasan — all 21 preset strings carried byte-identical
 * from v6.16.3.4.2. No preset removed, no feature dropped.
 */
ScrollView {
    id: root
    clip: true
    // v6.16.3.4.3: explicit contentWidth so the ScrollView sizes its
    // viewport correctly. Matches the BatterySettingsPage pattern.
    contentWidth: availableWidth

    // ── Current preset state ──
    property string currentPreset: "Default (Current)"

    // v6.16.3.4.3: tracks whether the user has an external/manual edit
    // that doesn't match any known preset. When true, the ComboBox
    // includes a "Custom (External Edit)" entry at the top.
    property bool externalEdit: false
    property string externalEditContent: ""

    readonly property string animStatePath: Quickshell.env("HOME") + "/.config/quickshell/zen-shell/animation-state.json"
    readonly property string liveConfPath:  Quickshell.env("HOME") + "/.config/hypr/modules/animations.conf"

    function saveAnimState() {
        animStateSaver.command = ["bash", "-c",
            "mkdir -p $(dirname '" + animStatePath + "') && " +
            "echo '{\"preset\":\"" + currentPreset.replace(/"/g, '\\"') + "\"}' > '" + animStatePath + "'"]
        animStateSaver.running = true
    }
    Process { id: animStateSaver; running: false }

    FileView {
        id: animStateLoader
        path: root.animStatePath
        blockLoading: false
        onLoaded: {
            try {
                const s = JSON.parse(this.text())
                if (s.preset && root.presetNames.indexOf(s.preset) >= 0) {
                    // Seed with saved choice, but live-conf read below may override.
                    root.currentPreset = s.preset
                }
            } catch (e) {}
        }
    }

    // v6.16.3.4.3: Read the ACTUAL animations.conf Hyprland is using and
    // reconcile it against the known presets. This is the source of truth.
    FileView {
        id: liveConfLoader
        path: root.liveConfPath
        blockLoading: false
        watchChanges: true
        onLoaded:       root._reconcileLiveConf(this.text())
        onFileChanged:  this.reload()
    }

    Component.onCompleted: {
        animStateLoader.reload()
        liveConfLoader.reload()
    }

