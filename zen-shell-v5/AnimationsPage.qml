    function applyPreset(name) {
        if (!presets[name]) return
        currentPreset = name
        externalEdit = false              // applying a known preset clears custom flag
        externalEditContent = ""
        saveAnimState()
        const path = Quickshell.env("HOME") + "/.config/hypr/modules/animations.conf"
        const content = "# Generated by Zen Settings — preset: " + name + "\n" + presets[name] + "\n"
        writeProc.command = ["bash", "-c",
            "mkdir -p $(dirname '" + path + "') && cat > '" + path + "' << 'ZENEOF'\n" + content + "\nZENEOF\n" +
            "hyprctl reload && echo OK"]
        writeProc.running = true
    }

    // v6.16.1.6: After `hyprctl reload`, Hyprland re-parses ~/.config/hypr/hyprland.conf
    // from scratch, which WIPES all runtime-applied keyword values from SettingsStateV2
    // (gaps, borders, rounding, blur, etc. reset to hyprland.conf defaults). Settings
    // appeared to "come back" only when the user opened Themes page because that re-
    // triggers applyToHyprland(). Fix: after reload completes, immediately re-push
    // SettingsStateV2's saved values so the user sees their configured state preserved.
    Process { id: writeProc; running: false
        onExited: (exitCode) => {
            if (typeof SettingsStateV2 !== "undefined" && exitCode === 0) {
                Qt.callLater(SettingsStateV2.applyToHyprland)
            }
        }
    }

    // ═══════════════════════════════════════════════════════════════
    // v6.16.3.4.3 — Reconcile live animations.conf with preset dict
    // ═══════════════════════════════════════════════════════════════
    //
    // Strategy:
    //   1. If the first line is "# Generated by Zen Settings — preset: X",
    //      trust it (fast path — our own writer produced this file).
    //   2. Strip the header and normalize whitespace. Compare normalized
    //      content against each preset. Use normalized equality.
    //   3. No match → mark externalEdit = true so UI shows
    //      "Custom (External Edit)".
    //
    // Normalization rules:
    //   - Collapse runs of whitespace → single space
    //   - Drop empty lines and comment lines
    //   - Trim both ends
    //
    // This tolerates formatting drift (user edits indentation, inserts
    // blank lines) without misreporting unchanged configs as custom.
    function _normalize(text) {
        if (!text) return ""
        const lines = text.split("\n")
        const out = []
        for (let i = 0; i < lines.length; i++) {
            let l = lines[i].replace(/\s+/g, " ").trim()
            if (l === "") continue
            if (l.charAt(0) === "#") continue
            out.push(l)
        }
        return out.join(" ")
    }

    function _reconcileLiveConf(text) {
        if (!text) {
            // File doesn't exist yet — keep whatever state JSON seeded us with
            return
        }

        // (1) Fast path: header comment declares the preset
        const headerMatch = text.match(/#\s*Generated by Zen Settings\s*[—-]\s*preset:\s*(.+)/)
        if (headerMatch) {
            const headerName = headerMatch[1].trim()
            if (root.presetNames.indexOf(headerName) >= 0) {
                root.currentPreset = headerName
                root.externalEdit = false
                root.externalEditContent = ""
                return
            }
        }

        // (2) Content match against preset dict
        const normLive = _normalize(text)
        const names = root.presetNames
        for (let i = 0; i < names.length; i++) {
            const name = names[i]
            const normPreset = _normalize(root.presets[name])
            if (normLive === normPreset) {
                root.currentPreset = name
                root.externalEdit = false
                root.externalEditContent = ""
                return
            }
        }

        // (3) No match — external edit
        root.externalEdit = true
        root.externalEditContent = text
        root.currentPreset = "Custom (External Edit)"
        console.log("[AnimationsPage] live animations.conf doesn't match any known preset — marked as Custom (External Edit)")
    }

    // ═══════════════════════════════════════════════════════════════
    // v6.16.3.4.3 — Content wrapper for proper ScrollView height
    // ═══════════════════════════════════════════════════════════════
    //
    // Wrapping the ColumnLayout in an Item whose implicitHeight explicitly
    // accounts for the y-offset + bottom padding ensures ScrollView can
    // scroll all the way to the last widget. Without this wrapper, the
    // PageFooter was clipped because ScrollView auto-height calculation
    // didn't include the 24px top offset.
    Item {
        implicitWidth: root.availableWidth
        implicitHeight: contentCol.y + contentCol.implicitHeight + 48

        ColumnLayout {
            id: contentCol
            width: root.availableWidth - 48
            x: 24; y: 24
            spacing: 16

            ColumnLayout {
                Layout.fillWidth: true
                spacing: 4
                Text {
                    text: "Animations"
                    font.family: Theme.fontFamily
                    font.pixelSize: 22
                    font.weight: Font.Bold
                    color: ThemeService.fg
                }
                Text {
                    text: "21 community presets — auto-applies to Hyprland"
                    font.family: Theme.fontFamily
                    font.pixelSize: 12
                    color: ThemeService.grey1
                }
            }

            ControlCenterBanner {
                feature: "Animation Bezier Editor"
                description: "Custom curves, per-animation tuning"
            }

            // v6.16.3.4.3: External-edit diagnostic banner — only visible when
            // the live animations.conf doesn't match any known preset. Gives
            // the user a clear "this is custom" indicator plus a one-click
            // revert to Default.
            Rectangle {
                visible: root.externalEdit
                Layout.fillWidth: true
                Layout.preferredHeight: 58
                radius: 10
                color: ThemeService.alpha(ThemeService.orange, 0.08)
                border.width: 1
                border.color: ThemeService.alpha(ThemeService.orange, 0.30)

                RowLayout {
                    anchors.fill: parent
                    anchors.leftMargin: 14
                    anchors.rightMargin: 14
                    spacing: 12

                    Text {
                        text: "\uf06a"     // fa-exclamation-circle
                        font.family: Theme.monoFont
                        font.pixelSize: 18
                        color: ThemeService.orange
                    }
                    ColumnLayout {
                        Layout.fillWidth: true
                        spacing: 2
                        Text {
                            text: "Custom animations detected"
                            font.family: Theme.fontFamily
                            font.pixelSize: 13
                            font.weight: Font.DemiBold
                            color: ThemeService.fg
                        }
                        Text {
                            text: "~/.config/hypr/modules/animations.conf doesn't match any bundled preset. Select a preset to overwrite."
                            font.family: Theme.fontFamily
                            font.pixelSize: 11
                            color: ThemeService.grey1
                            wrapMode: Text.WordWrap
                            Layout.fillWidth: true
                        }
                    }
                                        ZenButton {
                        text: "Restore default"
                        onClicked: root.applyPreset("Default (Current)")
                    }
                }
            }

            SettingsSection {
                title: "Preset"

                SettingRow {
                    label: "Select Preset"
                    description: "Writes to ~/.config/hypr/modules/animations.conf + hyprctl reload"

                    // v6.16.4.12.6.14: Migrated to ZenDropdown for the modern
                    // Justinmind-style look (fade-on-hover, search bar at 6+
                    // items, smooth open/close).
                    //
                    // Wala tayo babawasan: ZenComboBox.qml itself is untouched;
                    // pages that haven't migrated still use it. Only this one
                    // page was changed in this version. All preset behavior
                    // (Custom external edit detection, applyPreset wiring) is
                    // preserved byte-for-byte. The model now uses the rich
                    // entry shape so we can mark "Custom (External Edit)" with
                    // a meta hint, but the values still round-trip through
                    // root.applyPreset() unchanged.
                    ZenDropdown {
                        id: presetCombo
                        width: 220
                        model: {
                            const out = []
                            const list = root.displayPresetNames || []
                            for (var i = 0; i < list.length; i++) {
                                const name = list[i]
                                if (name === "Custom (External Edit)") {
                                    out.push({
                                        text: name,
                                        value: name,
                                        meta: "external",
                                        // Greyed but selectable so user can
                                        // see why it's there. Not enabled-false
                                        // because we still want the row
                                        // focusable to convey the state.
                                        enabled: true
                                    })
                                } else {
                                    out.push({ text: name, value: name })
                                }
                            }
                            return out
                        }
                        currentIndex: {
                            const list = root.displayPresetNames || []
                            const idx = list.indexOf(root.currentPreset)
                            return idx >= 0 ? idx : 0
                        }
                        onSelected: (entry) => {
                            const name = entry.value
                            // "Custom (External Edit)" is a synthetic entry;
                            // selecting it re-applies itself (no-op) rather
                            // than calling applyPreset() which would fail
                            // the presets[] lookup.
                            if (name === "Custom (External Edit)") return
                            root.applyPreset(name)
                        }
                    }
                }
            }

            SettingsSection {
                title: "Preview"

                Rectangle {
                    Layout.fillWidth: true
                    Layout.preferredHeight: 280
                    color: ThemeService.alpha(ThemeService.bg0, 0.8)
                    radius: 8
                    border.width: 1
                    border.color: ThemeService.alpha(ThemeService.fg, 0.1)
                    clip: true

                    Flickable {
                        anchors.fill: parent
                        anchors.margins: 12
                        contentWidth: previewText.implicitWidth
                        contentHeight: previewText.implicitHeight
                        clip: true

                        Text {
                            id: previewText
                            // v6.16.3.4.3: when externalEdit is true, show the
                            // actual live-conf text (read-only). Otherwise, show
                            // the selected preset from the dict.
                            text: root.externalEdit
                                  ? (root.externalEditContent || "")
                                  : (root.presets[root.currentPreset] || "")
                            font.family: Theme.monoFont
                            font.pixelSize: 11
                            color: ThemeService.grey0
                        }
                    }
                }
            }

            PageFooter {
                description: "Applies instantly via hyprctl reload"
                onResetRequested: root.applyPreset("Default (Current)")
            }

            // v6.16.3.4.3: bottom breathing room — combined with the wrapper
            // Item's implicitHeight this guarantees the PageFooter is fully
            // scrollable into view.
            Item { Layout.preferredHeight: 24 }
        }
    }
}
