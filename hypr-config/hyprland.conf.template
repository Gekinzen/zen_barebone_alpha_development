# ═══════════════════════════════════════════════════════════════
# HYPRLAND — Zen Shell Edition
# Path: ~/.config/hypr/hyprland.conf
# ═══════════════════════════════════════════════════════════════

# ── Variables ──
$terminal = kitty
$fileManager = thunar
$menu = fuzzel

# ── Environment ──
env = XCURSOR_SIZE,24
env = HYPRCURSOR_SIZE,24

# ── Input ──
input {
    kb_layout = us
    follow_mouse = 1
    sensitivity = 0
    touchpad {
        natural_scroll = false
    }
}

# ── Tiling ──
dwindle {
    pseudotile = true
    preserve_split = true
}

# ── Misc ──
misc {
    force_default_wallpaper = -1
    disable_hyprland_logo = true
}

# ═══════════════════════════════════════════════════════════════
# MODULES (in strict load order)
# ═══════════════════════════════════════════════════════════════

# 1. Personal modules
source = ~/.config/hypr/modules/autostart.conf
source = ~/.config/hypr/modules/look_and_feel.conf
source = ~/.config/hypr/modules/binds.conf

# 2. Zen Shell overrides (LAST so they take priority)
source = ~/.config/quickshell/zen-shell/config/hyprland-layer-rules.conf
source = ~/.config/quickshell/zen-shell/config/keybinds-update.conf
# v6.16.2.3.2: Mouse settings managed by Control Panel → Input.
# File auto-created by MouseSettingsService on first save (also seeded
# by install.sh with sane defaults so this source line is always valid).
source = ~/.config/hypr/zen-mouse.conf


env = XDG_CURRENT_DESKTOP,Hyprland
env = XDG_SESSION_TYPE,wayland
env = XDG_SESSION_DESKTOP,Hyprland
env = QT_QPA_PLATFORM,wayland
env = QT_QPA_PLATFORMTHEME,qt5ct
# Zen Shell display persistence
source = ~/.config/hypr/hyprland-monitors.conf
