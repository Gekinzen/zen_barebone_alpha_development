# ═══════════════════════════════════════════════════════════════
# HYPRLAND — Zen Shell Edition
# Path: ~/.config/hypr/hyprland.conf
# ═══════════════════════════════════════════════════════════════

# ── Variables ──
$terminal = kitty
$fileManager = thunar
$menu = fuzzel

# ── Environment ──
env = XCURSOR_SIZE,24
env = HYPRCURSOR_SIZE,24

# ── Input ──
input {
    kb_layout = us
    follow_mouse = 1
    sensitivity = 0
    touchpad {
        natural_scroll = false
    }
}

# ── Tiling ──
dwindle {
    # v7.0.0-beta.1-hf82l — `pseudotile = true` removed because
    # `dwindle:pseudotile` config option was removed in Hyprland 0.55
    # (Hyprland release notes: "dwindle:pseudotile has been removed
    # as it wasn't doing anything"). The `pseudo` dispatcher (bound
    # to SUPER+P in modules/binds.conf) still works per-window — it
    # toggles the pseudotile state on the focused window directly,
    # which is what users actually wanted from this config option
    # anyway. Removing the line keeps 0.55+ users error-free while
    # preserving identical UX on 0.53/0.54 (where the line was a
    # no-op per Hyprland's own description).
    preserve_split = true
}

# ── Misc ──
misc {
    force_default_wallpaper = -1
    disable_hyprland_logo = true
}

# ═══════════════════════════════════════════════════════════════
# MODULES (in strict load order)
# ═══════════════════════════════════════════════════════════════

# 1. Personal modules
source = ~/.config/hypr/modules/autostart.conf
source = ~/.config/hypr/modules/look_and_feel.conf
source = ~/.config/hypr/modules/binds.conf

# v6.16.3.4.4: sourced AFTER look_and_feel.conf so user-picked animation
# presets override the default animations { } block. Written by Zen
# Settings → Animations. If absent (fresh install before first preset
# save) install.sh copies the default animations.conf, so this source
# line is always valid.
source = ~/.config/hypr/modules/animations.conf

# 2. Zen Shell overrides (LAST so they take priority)
source = ~/.config/quickshell/zen-shell/config/hyprland-layer-rules.conf
source = ~/.config/quickshell/zen-shell/config/keybinds-update.conf
# v6.16.2.3.2: Mouse settings managed by Control Panel → Input.
# File auto-created by MouseSettingsService on first save (also seeded
# by install.sh with sane defaults so this source line is always valid).
source = ~/.config/hypr/zen-mouse.conf


env = XDG_CURRENT_DESKTOP,Hyprland
env = XDG_SESSION_TYPE,wayland
env = XDG_SESSION_DESKTOP,Hyprland
env = QT_QPA_PLATFORM,wayland
env = QT_QPA_PLATFORMTHEME,qt5ct
# Zen Shell display persistence
source = ~/.config/hypr/hyprland-monitors.conf
