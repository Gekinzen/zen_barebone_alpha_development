/* Alt+Tab Window Switcher - One Dark Theme */
/* Matches Hyprland Control Center One Dark colorscheme */
/* Save as ~/.config/rofi/window-switcher-onedark.rasi */

* {
    /* One Dark Colors - from ~/.config/hypr/colorscheme/one-dark.css */
    bg0: #282c34;
    bg1: #21252b;
    bg2: #2c313a;
    bg3: #3e4451;
    bg4: #4b5263;
    
    red: #e06c75;
    orange: #d19a66;
    yellow: #e5c07b;
    green: #98c379;
    aqua: #56b6c2;
    blue: #61afef;
    purple: #c678dd;
    
    fg: #abb2bf;
    grey0: #5c6370;
    grey1: #828997;
    grey2: #abb2bf;
    
    /* Smart Theme Colors */
    hover-color: #e06c75;
    active-color: #61afef;
    
    /* Rofi-specific variables */
    background-color: transparent;
    text-color: @fg;
    font: "JetBrainsMono Nerd Font Propo 11";
}

window {
    width: 50%;
    location: center;
    anchor: center;
    transparency: "real";
    background-color: @bg0;
    border: 2px solid;
    border-color: @active-color;
    border-radius: 8px;
}

mainbox {
    padding: 15px;
    background-color: transparent;
}

inputbar {
    children: [prompt, entry];
    background-color: @bg2;
    border-radius: 6px;
    padding: 10px;
    margin: 0px 0px 10px 0px;
}

prompt {
    text-color: @blue;
    padding: 0px 10px 0px 0px;
    font: "JetBrainsMono Nerd Font Propo Bold 12";
}

entry {
    placeholder: "Search windows...";
    placeholder-color: @grey0;
    text-color: @fg;
}

message {
    background-color: @bg2;
    border-radius: 6px;
    padding: 10px;
    margin: 0px 0px 10px 0px;
}

textbox {
    text-color: @grey1;
}

listview {
    lines: 8;
    scrollbar: true;
    cycle: true;
    dynamic: true;
    spacing: 5px;
    background-color: transparent;
}

element {
    padding: 12px;
    border-radius: 4px;
    background-color: transparent;
    text-color: @fg;
}

element normal.normal {
    background-color: transparent;
    text-color: @fg;
}

element normal.urgent {
    background-color: @red;
    text-color: @bg0;
}

element normal.active {
    background-color: @bg3;
    text-color: @blue;
}

element selected.normal {
    background-color: @bg3;
    text-color: @active-color;
    border: 2px solid;
    border-color: @active-color;
}

element selected.urgent {
    background-color: @red;
    text-color: @bg0;
    border: 2px solid;
    border-color: @red;
}

element selected.active {
    background-color: @bg3;
    text-color: @active-color;
    border: 2px solid;
    border-color: @active-color;
}

element alternate.normal {
    background-color: transparent;
    text-color: @fg;
}

element alternate.urgent {
    background-color: @red;
    text-color: @bg0;
}

element alternate.active {
    background-color: @bg3;
    text-color: @blue;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}

element-icon {
    size: 32px;
    background-color: transparent;
}

scrollbar {
    handle-color: @active-color;
    background-color: @bg2;
    border-radius: 4px;
    handle-width: 6px;
    padding: 2px;
}

mode-switcher {
    spacing: 0;
}

button {
    padding: 10px;
    background-color: @bg2;
    text-color: @grey1;
    border-radius: 4px;
    margin: 2px;
}

button selected {
    background-color: @active-color;
    text-color: @bg0;
}