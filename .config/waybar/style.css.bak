/* Waybar Style: Classic - Generated 2026-02-02 10:09 */
/* User: paul | Home: /home/paul */
@import '../hypr/colorscheme/current.css';

* {
    font-family: "Adwaita Sans", "JetBrainsMono Nerd Font Propo", sans-serif;
    font-size: 19px;
    font-weight: bold;
    min-height: 0;
    border: none;
    border-radius: 0;
    padding: 0;
    margin: 0;
}

#waybar {
    background: alpha(@bg0, 0.50);
    border-radius: 16px;
    color: @fg;
    margin: 3px;
    margin-bottom: 0px;
}

tooltip {
    background: @bg0;
    border: 1px solid @bg3;
    border-radius: 12px;
}

tooltip label {
    color: @fg;
    padding: 6px;
}

.modules-center, .modules-left, .modules-right {
    background-color: transparent;
    margin: 3px;
    padding: 4px;
}

#bluetooth, #temperature, #custom-music, #clock, #battery, #pulseaudio,
#network, #cpu, #memory, #custom-menuApp, #custom-power, #custom-switcher,
#custom-notification, #custom-pacman, #tray {
    background-color: alpha(@bg0, 0.9);
    padding: 0 15px;
    margin: 0 0 0 12px;
    border-radius: 45px;
    border: 1px solid @bg1;
    transition: all 0.3s ease;
}


/* Module Colors */
#cpu { color: @blue; }
#memory { color: @green; }
#temperature { color: @orange; }
#pulseaudio { color: @yellow; }
#battery { color: @green; }
#bluetooth { color: @blue; }
#clock { color: @blue; }
#network { color: @purple; }
#custom-pacman { color: @cyan; }
#custom-music { color: #f5c2e7; }


/* Hover Effects */
#cpu:hover {
    background: alpha(@blue, 0.12);
    text-shadow: 0px 0px 2px alpha(@blue, 0.6);
}
#memory:hover {
    background: alpha(@green, 0.12);
    text-shadow: 0px 0px 2px alpha(@green, 0.6);
}
#temperature:hover {
    background: alpha(@orange, 0.12);
    text-shadow: 0px 0px 2px alpha(@orange, 0.6);
}
#pulseaudio:hover {
    background: alpha(@yellow, 0.12);
    text-shadow: 0px 0px 2px alpha(@yellow, 0.6);
}
#battery:hover {
    background: alpha(@green, 0.12);
    text-shadow: 0px 0px 2px alpha(@green, 0.6);
}
#bluetooth:hover {
    background: alpha(@blue, 0.12);
    text-shadow: 0px 0px 2px alpha(@blue, 0.6);
}
#clock:hover {
    background: alpha(@blue, 0.12);
    text-shadow: 0px 0px 2px alpha(@blue, 0.6);
}
#network:hover {
    background: alpha(@purple, 0.12);
    text-shadow: 0px 0px 2px alpha(@purple, 0.6);
}
#custom-pacman:hover {
    background: alpha(@cyan, 0.12);
    text-shadow: 0px 0px 2px alpha(@cyan, 0.6);
}


#custom-pacman.updated {
    color: @green;
    background: alpha(@green, 0.15);
}

#custom-pacman.pending {
    color: @blue;
    background: alpha(@blue, 0.15);
}

#custom-pacman.warning {
    color: @yellow;
    background: alpha(@yellow, 0.15);
}

#custom-pacman.critical {
    color: @red;
    background: alpha(@red, 0.15);
}

#workspaces {
    background-color: alpha(@bg0, 0.21);
    border-radius: 26px;
    padding: 5px 3px;
    margin-left: 5px;
    border: 1px solid @bg1;
    transition: all 0.5s ease-in-out;
}

#workspaces button {
    background-color: @bg1;
    border-radius: 16px;
    padding: 0px;
    margin-right: 5px;
    min-width: 22px;
    transition: all 0.5s ease-out;
}

#workspaces button.active {
    min-width: 50px;
    background-color: @blue;
}

#workspaces button:hover {
    background-color: @purple;
}

#workspaces button.urgent {
    background-color: @red;
}

#taskbar {
    background-color: alpha(@bg0, 0.9);
    padding: 5px 6px;
    margin: 0 0 0 24px;
    border-radius: 18px;
    border: 1px solid @bg1;
}

#taskbar button {
    padding: 0.4em 0.8em;
    margin: 0 4px;
    border-radius: 13px;
    background-color: @bg1;
    color: @fg;
    transition: all 0.25s ease-in-out;
}

#taskbar button.active {
    background-color: @blue;
    color: @bg0;
}

#taskbar button:hover {
    background-color: @bg3;
    color: @fg;
}

#custom-taskbar {
    background-color: alpha(@bg0, 0.9);
    padding: 0 30px;
    margin: 0 0 0 24px;
    border-radius: 45px;
    border: 1px solid @bg1;
    font-family: "JetBrainsMono Nerd Font Propo";
    font-size: 24px;
    color: @fg;
}

#custom-start-menu {
    background-image: url("/home/paul/.config/hypr-control-center/assets/start-icons/arch.svg");
    background-size: 24px 24px;
    background-repeat: no-repeat;
    background-position: center;
    min-width: 36px;
    min-height: 36px;
    border-radius: 50%;
    padding: 0;
    margin-left: 8px;
}

#custom-start-menu:hover {
    background-color: alpha(@bg0, 0.6);
}

#custom-music {
    font-size: 18px;
}

#custom-music:hover {
    border-radius: 16px;
    background-color: rgba(69, 71, 90, 0.55);
}

#tray {
    padding: 0px 5px;
}

#tray > .passive {
    -gtk-icon-effect: dim;
}

#tray > .needs-attention {
    -gtk-icon-effect: highlight;
    background-color: @red;
}
