{
    "height": 40,
    "position": "bottom",
    "layer": "top",
    "margin-top": 0,
    "marfin-right": 0,
    "margin-bottom": 0,
    "margin-left": 0,
    "modules-left": [
        "custom/taskbar",
        "custom/pinned"
    ],
    "modules-center": [
        "hyprland/workspaces",
        "hyprland/window"
    ],
    "modules-right": [
        "pulseaudio",
        "network",
        "battery",
        "custom/notification",
        "clock"
    ],
    "clock": {
        "format": "\uf017 {:%I:%M:%S %p} ",
        "interval": 1,
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "format": {
                "today": "<span color='#fAfBfC'><b>{}</b></span>"
            }
        },
        "actions": {
            "on-click-right": "shift_down",
            "on-click": "shift_up"
        }
    },
    "hyprland/workspaces": {
        "disable-scroll": true,
        "sort-by-name": true,
        "format": " {icon} ",
        "persistent-workspaces": {
            "*": 4
        },
        "format-icons": {
            "1": "",
            "2": "",
            "3": "",
            "4": "",
            "5": "",
            "6": "",
            "7": "",
            "urgent": "",
            "focused": "",
            "inactive": "",
            "empty": ""
        },
        "on-scroll-up": "hyprctl dispatch workspace e+1",
        "on-scroll-down": "hyprctl dispatch workspace e-1",
        "on-click": "activate"
    },
    "tray": {
        "icon-size": 21,
        "spacing": 10
    },
    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-bluetooth": "{volume}% {icon}\uf294",
        "format-muted": "\uf026",
        "format-icons": {
            "headphone": "\uf025",
            "hands-free": "\uf590",
            "headset": "\uf590",
            "phone": "\uf095",
            "phone-muted": "\ued17",
            "portable": "\uf095",
            "car": "\uf1b9",
            "default": [
                "\uf027",
                "\uf028"
            ]
        },
        "scroll-step": 1,
        "on-click": "pavucontrol",
        "ignored-sinks": [
            "Easy Effects Sink"
        ]
    },
    "network": {
        "interface": "wlp2s0",
        "format": "{ifname}",
        "format-wifi": "{essid} ({signalStrength}%) \uf1eb",
        "format-ethernet": "{ipaddr}/{cidr} \udb80\ude97",
        "format-disconnected": "",
        "tooltip-format": "{ifname} via {gwaddr} \udb80\ude97",
        "tooltip-format-wifi": "{essid} ({signalStrength}%) \uf1eb",
        "tooltip-format-ethernet": "{ifname} \uf0c1",
        "tooltip-format-disconnected": "Disconnected",
        "max-length": 50
    },
    "battery": {
        "interval": 60,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-icons": [
            "\uf244",
            "\uf243",
            "\uf242",
            "\uf241",
            "\uf240"
        ],
        "max-length": 25
    },
    "custom/notification": {
        "tooltip": true,
        "format": "<span size='16pt'>{icon}</span>",
        "format-icons": {
            "notification": "\udb84\udd6b",
            "none": "\udb80\udc9c",
            "dnd-notification": "\udb80\udca0",
            "dnd-none": "\udb82\ude93",
            "inhibited-notification": "\udb80\udc9b",
            "inhibited-none": "\udb82\ude91",
            "dnd-inhibited-notification": "\udb80\udc9b",
            "dnd-inhibited-none": "\udb82\ude91"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },
    "margin-right": 5,
"custom/taskbar": {
    "return-type": "json",
    "exec": "~/.config/hypr/scripts/waybar/taskbar-render.sh",
    "interval": 1,
    "format": "{}",
    "escape": false,
    "on-click": "~/.config/hypr/scripts/waybar/taskbar-click.sh",
    "on-click-middle": "~/.config/hypr/scripts/waybar/taskbar-smart-click.sh",
    "on-click-right": "~/.config/hypr/scripts/waybar/taskbar-menu-global.sh"
},
    "temperature": {
        "tooltip": true,
        "format": "{icon} ",
        "format-icons": [
            "\u2581",
            "\u2582",
            "\u2583",
            "\u2584",
            "\u2585",
            "\u2586",
            "\u2587",
            "\u2588"
        ],
        "tooltip-format": "{temperatureC}\u00b0C"
    },
    "cpu": {
        "interval": 1,
        "format": "{icon} ",
        "format-icons": [
            "\u2581",
            "\u2582",
            "\u2583",
            "\u2584",
            "\u2585",
            "\u2586",
            "\u2587",
            "\u2588"
        ],
        "on-click": "/home/zen/.config/alacritty/btmrun.sh"
    },
    "memory": {
        "interval": 1,
        "format": "{icon} ",
        "format-icons": [
            "\u2581",
            "\u2582",
            "\u2583",
            "\u2584",
            "\u2585",
            "\u2586",
            "\u2587",
            "\u2588"
        ],
        "tooltip": true,
        "tooltip-format": "{}%",
        "on-click": "/home/zen/.config/alacritty/btmrun.sh"
    },
    "bluetooth": {
        "format": "  ",
        "format-disabled": "  ",
        "format-connected": " {num_connections} connected",
        "on-click": "/home/zen/.config/alacritty/bluetoothrun.sh"
    },
    "custom/music": {
        "format": "{}",
        "escape": true,
        "interval": 1,
        "tooltip": false,
        "exec": "playerctl status | grep -q Playing && echo ' \u23f8 ' || echo ' \u25b6 '",
        "on-click": "playerctl play-pause"
    },
    "custom/power": {
        "tooltip": false,
        "on-click": "/home/zen/.config/rofi/power.sh",
        "format": ""
    },
    "custom/menuApp": {
        "tooltip": false,
        "on-click": "/home/zen/.config/rofi/launcher.sh",
        "format": "  "
    },
    "custom/switcher": {
        "tooltip": false,
        "on-click": "/home/zen/.config/rofi/switcher.sh",
        "format": " \udb83\ude31  "
    },
    "custom/pinned": {
        "return-type": "json",
        "exec": "~/.config/hypr/scripts/waybar/pinned-apps-render.sh",
        "interval": 2,
        "format": "{}",
        "escape": false,
        "on-click": "~/.config/hypr/scripts/waybar/pinned-apps-click.sh"
    },
    "wlr/taskbar": {
        "format": "{icon} {count}",
        "all-outputs": true,
        "on-click": "activate",
        "on-click-middle": "exec ~/.config/hypr/scripts/waybar/taskbar-smart-click.sh",
        "on-click-right": "exec ~/.config/hypr/scripts/waybar/taskbar-wlr-menu.sh"
    },
    "hyprland/window": {
        "format": "{title}",
        "max-length": 50,
        "separate-outputs": true,
        "rewrite": {
            "(.*) \u2014 Mozilla Firefox": "  $1",
            "(.*) - Mozilla Firefox": "  $1",
            "(.*) - Visual Studio Code": "  $1",
            "(.*) - Code": "  $1",
            "(.*) - kitty": "  $1",
            "(.*)": "  $1"
        }
    }
}